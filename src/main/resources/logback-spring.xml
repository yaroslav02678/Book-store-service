<configuration>

    <property name="LOG_PATH" value="logs"/>

    <!-- === Appenders === -->
    <appender name="BUSINESS" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/business.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SECURITY" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/security.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ERRORS" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/errors.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- === Loggers === -->
    <logger name="BusinessLogger" level="INFO" additivity="false">
        <appender-ref ref="BUSINESS"/>
    </logger>

    <logger name="SecurityLogger" level="INFO" additivity="false">
        <appender-ref ref="SECURITY"/>
    </logger>

    <logger name="ErrorLogger" level="ERROR" additivity="false">
        <appender-ref ref="ERRORS"/>
    </logger>

    <!-- === Root (console) === -->
    <root level="INFO">
        <appender-ref ref="BUSINESS"/>
        <appender-ref ref="SECURITY"/>
        <appender-ref ref="ERRORS"/>
    </root>

</configuration>
